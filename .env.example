# Leave both empty to require a MELCloud login for each browser session.
MELCLOUD_EMAIL=your-email@example.com
MELCLOUD_PASSWORD=your-password
# Optional: pigwin | olivier (defaults to olivier)
MELCLOUD_PROVIDER=
PORT=3000
# Optional: Trust proxy settings for reverse proxies (e.g., when behind Nginx or Heroku)
TRUST_PROXY=true
# Recommended in production; changing it invalidates existing web sessions.
SESSION_SECRET=random-string-here
